{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://civix.app/schema/brief.schema.json",
  "title": "Civix Daily Brief",
  "type": "object",
  "required": ["brief_id", "published_at", "schema_version", "stories"],
  "additionalProperties": false,
  "properties": {
    "brief_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "ISO date this brief was published for, e.g. 2026-09-01"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "stories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/definitions/story" }
    }
  },
  "definitions": {
    "citation": {
      "type": "object",
      "required": ["label", "url"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "cited_text": {
          "type": "string",
          "description": "Optional excerpt of the primary source text this claim is grounded in (from the Claude citations feature)"
        }
      }
    },
    "sourced_text": {
      "type": "object",
      "required": ["text", "citations"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/citation" }
        }
      }
    },
    "argument_side": {
      "type": "object",
      "required": ["label", "text", "word_count"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "word_count": { "type": "integer", "minimum": 1 }
      }
    },
    "check": {
      "type": "object",
      "required": ["question", "options", "answer_index", "explanation"],
      "additionalProperties": false,
      "properties": {
        "question": { "type": "string", "minLength": 1 },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": { "type": "string", "minLength": 1 }
        },
        "answer_index": { "type": "integer", "minimum": 0 },
        "explanation": { "type": "string", "minLength": 1 }
      }
    },
    "review": {
      "type": "object",
      "required": ["approved_at", "edited"],
      "additionalProperties": false,
      "properties": {
        "approved_at": { "type": "string", "format": "date-time" },
        "edited": { "type": "boolean" }
      }
    },
    "story": {
      "type": "object",
      "required": [
        "id", "headline", "topics",
        "what_happened", "why_it_matters", "argument", "check"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "minLength": 1
        },
        "headline": { "type": "string", "minLength": 1, "maxLength": 120 },
        "topics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "economy", "education", "healthcare", "environment",
              "technology", "immigration", "justice", "elections",
              "foreign-policy", "labor", "housing", "civil-rights"
            ]
          }
        },
        "what_happened": { "$ref": "#/definitions/sourced_text" },
        "why_it_matters": { "$ref": "#/definitions/sourced_text" },
        "argument": {
          "type": "object",
          "required": ["side_a", "side_b"],
          "additionalProperties": false,
          "properties": {
            "side_a": { "$ref": "#/definitions/argument_side" },
            "side_b": { "$ref": "#/definitions/argument_side" }
          }
        },
        "check": { "$ref": "#/definitions/check" },
        "review": { "$ref": "#/definitions/review" }
      }
    }
  }
}
